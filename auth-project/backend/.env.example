PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/auth_demo
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000,https://your-vercel-app.vercel.app

# Optional real email OTP delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Optional real phone OTP delivery through Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
